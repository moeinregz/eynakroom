PORT=4000

# ورود به داشبورد
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1

# یه رشته‌ی طولانی و تصادفی
JWT_SECRET=change-this-to-a-long-random-string

# رشته‌ی اتصال MongoDB Atlas — اسم دیتابیس داخل آدرس باشه (بعد از .mongodb.net/)
# مثال: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/eynakroom?retryWrites=true&w=majority
# اگه خالی بذاری، موقع اجرای محلی از فایل‌های JSON داخل data/ استفاده می‌شه
MONGODB_URI=
